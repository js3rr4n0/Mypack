# --- Base de datos (Neon) ---
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/mypack?sslmode=require"

# --- Wompi ---
# SV = Wompi El Salvador (App ID + API Secret, USD)
# CO = Wompi Colombia (llaves pub_/prv_, COP)
WOMPI_COUNTRY="SV"

# Wompi El Salvador (panel -> Configuracion -> Credenciales API)
WOMPI_APP_ID="00000000-0000-0000-0000-000000000000"
WOMPI_API_SECRET="00000000-0000-0000-0000-000000000000"
# Token propio que viaja en la URL del webhook; Wompi SV no firma sus eventos.
WOMPI_WEBHOOK_TOKEN="genera-un-string-aleatorio-largo"
# Acepta transacciones de prueba (esReal=false). Dejar en false en produccion.
WOMPI_ALLOW_TEST_TRANSACTIONS="true"

# Solo si WOMPI_COUNTRY=CO
# WOMPI_ENV="sandbox"
# WOMPI_PUBLIC_KEY="pub_test_xxxxxxxxxxxxxxxx"
# WOMPI_PRIVATE_KEY="prv_test_xxxxxxxxxxxxxxxx"
# WOMPI_INTEGRITY_SECRET="test_integrity_xxxxxxxxxxxxxxxx"
# WOMPI_EVENTS_SECRET="test_events_xxxxxxxxxxxxxxxx"

# --- Sitio ---
NEXT_PUBLIC_SITE_URL="https://mypack.lol"
# Debe coincidir con WOMPI_COUNTRY: USD para SV, COP para CO.
NEXT_PUBLIC_CURRENCY="USD"

# --- Subida de logos (opcional; sin token se usa base64) ---
BLOB_READ_WRITE_TOKEN=""
