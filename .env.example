# --- Base de datos (Neon) ---
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/mypack?sslmode=require"

# --- Wompi (El Salvador) ---
# Panel de Wompi -> Configuracion -> Credenciales API
WOMPI_APP_ID="00000000-0000-0000-0000-000000000000"
WOMPI_API_SECRET="00000000-0000-0000-0000-000000000000"
# Token propio que viaja en la URL del webhook; Wompi no firma sus eventos.
WOMPI_WEBHOOK_TOKEN="genera-un-string-aleatorio-largo"
# Acepta transacciones de prueba (esReal=false). Poner en false en produccion.
WOMPI_ALLOW_TEST_TRANSACTIONS="true"

# --- Contador de visitas ---
# Sal para el hash de visitantes. Cualquier cadena larga y aleatoria.
# Sin ella el contador funciona igual, pero con una propia los hashes no son
# adivinables. Si la cambias, el conteo del dia en curso se reinicia.
VISIT_SALT=""

# --- Sitio ---
NEXT_PUBLIC_SITE_URL="https://mypack.lol"

# --- Subida de logos (opcional; sin token se usa base64) ---
BLOB_READ_WRITE_TOKEN=""
